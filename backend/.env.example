DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/mobile_order
CUSTOMER_JWT_SECRET=replace-with-a-long-random-secret
# Development examples. Production requires explicit HTTPS origins and rejects localhost.
CUSTOMER_WS_ALLOWED_ORIGINS=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Demo authentication (server-side only; never expose these as Vite variables)
APP_ENV=development
DEMO_AUTH_PASSWORD=replace-with-the-internal-demo-password
DEMO_AUTH_SECRET=replace-with-a-separate-random-secret-at-least-32-characters
# 1-120 minutes (30 recommended for the internal demo)
DEMO_AUTH_SESSION_MINUTES=30
DEMO_AUTH_ALLOWED_ORIGINS=http://localhost:5173
# Set to false only for local HTTP development. Production must use true.
DEMO_AUTH_COOKIE_SECURE=false
DEMO_AUTH_RATE_LIMIT_ATTEMPTS=5
DEMO_AUTH_RATE_LIMIT_WINDOW_SECONDS=300

# Process-local API rate limits. Safe defaults are used when omitted.
CUSTOMER_JOIN_RATE_LIMIT=10
CUSTOMER_JOIN_RATE_WINDOW_SECONDS=60
CUSTOMER_ORDER_RATE_LIMIT=5
CUSTOMER_ORDER_RATE_WINDOW_SECONDS=60
STAFF_ORDER_RATE_LIMIT=10
STAFF_ORDER_RATE_WINDOW_SECONDS=60
CUSTOMER_SELECTION_RATE_LIMIT=60
CUSTOMER_SELECTION_RATE_WINDOW_SECONDS=60
# Maximum number of distinct in-memory limiter keys.
API_RATE_LIMIT_MAX_KEYS=10000

AWS_REGION=ap-northeast-1
AWS_S3_BUCKET_NAME=your-product-image-bucket
COGNITO_USER_POOL_ID=your-user-pool-id
COGNITO_APP_CLIENT_ID=your-spa-app-client-id
# Optional. If omitted, it is derived from Region and User Pool ID.
COGNITO_ISSUER=https://cognito-idp.ap-northeast-1.amazonaws.com/your-user-pool-id

# Install under /etc/nginx/conf.d/ after replacing every CHANGE_ME value.
# This file is loaded inside nginx's `http` context.

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

limit_req_zone $binary_remote_addr zone=mobile_order_api:10m rate=10r/s;
limit_req_zone $binary_remote_addr zone=mobile_order_upload:1m rate=2r/s;
limit_conn_zone $binary_remote_addr zone=mobile_order_connections:10m;

# Deliberately omit query strings, request bodies, referrers and request
# headers so authorization codes, signed URLs, JWTs and cookies are not logged.
log_format mobile_order_safe '$remote_addr [$time_local] '
                             '"$request_method $uri $server_protocol" '
                             '$status $body_bytes_sent $request_time';
access_log /var/log/nginx/mobile-order-access.log mobile_order_safe;
error_log /var/log/nginx/mobile-order-error.log error;

upstream mobile_order_backend {
    server 127.0.0.1:8000;
    keepalive 16;
}

server {
    listen 80;
    listen [::]:80;
    server_name CHANGE_ME.example.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name CHANGE_ME.example.com;

    ssl_certificate     /etc/letsencrypt/live/CHANGE_ME.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/CHANGE_ME.example.com/privkey.pem;

    root /var/www/mobile-order/dist;
    index index.html;

    # Replace the two CSP_CHANGE_ME tokens with complete origins before
    # installing this template. Nginx does not expand shell environment
    # variables in configuration files. Keep CSP in Report-Only mode until
    # the production Cognito, S3 image and WebSocket flows are verified.
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header X-Frame-Options "DENY" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), accelerometer=(), gyroscope=(), magnetometer=()" always;
    add_header Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self'; style-src 'self'; connect-src 'self' wss://$host CSP_CHANGE_ME_COGNITO_ORIGIN; img-src 'self' blob: CSP_CHANGE_ME_S3_IMAGE_ORIGIN; font-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'; frame-src 'none'; worker-src 'none'; media-src 'none';" always;

    # Do not enable HSTS until the public domain, certificate and all HTTPS
    # application flows have been verified. See README.md for staged rollout.

    client_max_body_size 64k;
    limit_req_status 429;
    limit_conn_status 429;

    location ~ ^/api/admin/products/[1-9][0-9]*/image$ {
        client_max_body_size 6m;
        limit_req zone=mobile_order_upload burst=5 nodelay;
        limit_conn mobile_order_connections 10;
        proxy_pass http://mobile_order_backend;
        proxy_http_version 1.1;
        proxy_read_timeout 60s;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /api/ {
        limit_req zone=mobile_order_api burst=30 nodelay;
        limit_conn mobile_order_connections 20;
        proxy_pass http://mobile_order_backend;
        proxy_http_version 1.1;
        proxy_read_timeout 60s;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /ws/ {
        # Do not apply request-rate limiting to persistent WebSocket traffic.
        limit_conn mobile_order_connections 20;
        proxy_pass http://mobile_order_backend;
        proxy_http_version 1.1;
        proxy_read_timeout 75s;
        proxy_send_timeout 75s;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}

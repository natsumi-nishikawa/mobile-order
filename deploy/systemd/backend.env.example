# Copy to /etc/mobile-order/backend.env, replace every REPLACE_WITH value,
# then set owner root:root and mode 0600. Never commit the rendered file.
APP_ENV=production
DATABASE_URL=REPLACE_WITH_LOCAL_POSTGRESQL_URL
CUSTOMER_JWT_SECRET=REPLACE_WITH_LONG_RANDOM_CUSTOMER_JWT_SECRET
CUSTOMER_WS_ALLOWED_ORIGINS=https://REPLACE_WITH_PUBLIC_DOMAIN
CORS_ALLOWED_ORIGINS=https://REPLACE_WITH_PUBLIC_DOMAIN

DEMO_AUTH_PASSWORD=REPLACE_WITH_DEMO_PASSWORD
DEMO_AUTH_SECRET=REPLACE_WITH_SEPARATE_LONG_RANDOM_DEMO_SECRET
DEMO_AUTH_SESSION_MINUTES=30
DEMO_AUTH_ALLOWED_ORIGINS=https://REPLACE_WITH_PUBLIC_DOMAIN
DEMO_AUTH_COOKIE_SECURE=true
DEMO_AUTH_RATE_LIMIT_ATTEMPTS=5
DEMO_AUTH_RATE_LIMIT_WINDOW_SECONDS=300

CUSTOMER_JOIN_RATE_LIMIT=10
CUSTOMER_JOIN_RATE_WINDOW_SECONDS=60
CUSTOMER_ORDER_RATE_LIMIT=5
CUSTOMER_ORDER_RATE_WINDOW_SECONDS=60
STAFF_ORDER_RATE_LIMIT=10
STAFF_ORDER_RATE_WINDOW_SECONDS=60
CUSTOMER_SELECTION_RATE_LIMIT=60
CUSTOMER_SELECTION_RATE_WINDOW_SECONDS=60
API_RATE_LIMIT_MAX_KEYS=10000

AWS_REGION=REPLACE_WITH_AWS_REGION
AWS_S3_BUCKET_NAME=REPLACE_WITH_PRODUCT_IMAGE_BUCKET
COGNITO_USER_POOL_ID=REPLACE_WITH_USER_POOL_ID
COGNITO_APP_CLIENT_ID=REPLACE_WITH_APP_CLIENT_ID
# Optional: omit to derive the issuer from AWS_REGION and COGNITO_USER_POOL_ID.
# COGNITO_ISSUER=https://REPLACE_WITH_COGNITO_ISSUER

# Do not add AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY, AWS_SESSION_TOKEN,
# AWS_PROFILE, AWS_SHARED_CREDENTIALS_FILE, or AWS_CONFIG_FILE in production.

# Merge only settings supported by the installed PostgreSQL version. Keep the
# Ubuntu package's existing log_destination/logging_collector arrangement so
# /etc/logrotate.d/postgresql-common remains authoritative.
log_connections = on
log_disconnections = on
log_statement = 'none'
log_duration = off
log_min_duration_statement = -1
log_parameter_max_length = 0
log_parameter_max_length_on_error = 0

# Install as /etc/mobile-order/backup.env with root:root 0600.
# The systemd manager reads this file before changing to the backup user.
# Do not put a database password or fixed AWS credential in this file.
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=REPLACE_WITH_DATABASE_NAME
PGUSER=REPLACE_WITH_BACKUP_ROLE
PGPASSFILE=/var/lib/mobile-order-backup/.pgpass

BACKUP_S3_BUCKET=REPLACE_WITH_PRIVATE_BACKUP_BUCKET
BACKUP_S3_PREFIX=postgresql
AWS_REGION=REPLACE_WITH_AWS_REGION
BACKUP_LOCAL_DIR=/var/lib/mobile-order-backup

\set ON_ERROR_STOP on

-- Review the inventory queries in README.md before running this file. This is
-- intentionally explicit: remove nonexistent objects and add every discovered
-- application object. Never replace this list with blind REASSIGN OWNED on a
-- shared database.
ALTER DATABASE REPLACE_WITH_DATABASE_NAME OWNER TO REPLACE_WITH_MIGRATION_ROLE;
\connect REPLACE_WITH_DATABASE_NAME
ALTER SCHEMA public OWNER TO REPLACE_WITH_MIGRATION_ROLE;

ALTER TABLE public.alembic_version OWNER TO REPLACE_WITH_MIGRATION_ROLE;
ALTER TABLE public.tables OWNER TO REPLACE_WITH_MIGRATION_ROLE;
ALTER TABLE public.business_hours OWNER TO REPLACE_WITH_MIGRATION_ROLE;
ALTER TABLE public.categories OWNER TO REPLACE_WITH_MIGRATION_ROLE;
ALTER TABLE public.products OWNER TO REPLACE_WITH_MIGRATION_ROLE;
ALTER TABLE public.product_categories OWNER TO REPLACE_WITH_MIGRATION_ROLE;
ALTER TABLE public.sessions OWNER TO REPLACE_WITH_MIGRATION_ROLE;
ALTER TABLE public.participants OWNER TO REPLACE_WITH_MIGRATION_ROLE;
ALTER TABLE public.orders OWNER TO REPLACE_WITH_MIGRATION_ROLE;
ALTER TABLE public.selections OWNER TO REPLACE_WITH_MIGRATION_ROLE;
ALTER TABLE public.order_items OWNER TO REPLACE_WITH_MIGRATION_ROLE;

ALTER SEQUENCE public.tables_id_seq OWNER TO REPLACE_WITH_MIGRATION_ROLE;
ALTER SEQUENCE public.business_hours_id_seq OWNER TO REPLACE_WITH_MIGRATION_ROLE;
ALTER SEQUENCE public.categories_id_seq OWNER TO REPLACE_WITH_MIGRATION_ROLE;
ALTER SEQUENCE public.products_id_seq OWNER TO REPLACE_WITH_MIGRATION_ROLE;
ALTER SEQUENCE public.product_categories_id_seq OWNER TO REPLACE_WITH_MIGRATION_ROLE;
ALTER SEQUENCE public.sessions_id_seq OWNER TO REPLACE_WITH_MIGRATION_ROLE;
ALTER SEQUENCE public.participants_id_seq OWNER TO REPLACE_WITH_MIGRATION_ROLE;
ALTER SEQUENCE public.orders_id_seq OWNER TO REPLACE_WITH_MIGRATION_ROLE;
ALTER SEQUENCE public.selections_id_seq OWNER TO REPLACE_WITH_MIGRATION_ROLE;
ALTER SEQUENCE public.order_items_id_seq OWNER TO REPLACE_WITH_MIGRATION_ROLE;

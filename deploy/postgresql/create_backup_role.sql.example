\set ON_ERROR_STOP on

-- Run as an existing PostgreSQL administrator after replacing identifiers.
-- Set the password afterwards with interactive psql \password. Never store it
-- in this file or shell history.
CREATE ROLE REPLACE_WITH_BACKUP_ROLE
    LOGIN
    NOSUPERUSER
    NOCREATEDB
    NOCREATEROLE
    NOINHERIT
    NOREPLICATION
    NOBYPASSRLS;

REVOKE ALL ON DATABASE REPLACE_WITH_DATABASE_NAME FROM REPLACE_WITH_BACKUP_ROLE;
GRANT CONNECT ON DATABASE REPLACE_WITH_DATABASE_NAME TO REPLACE_WITH_BACKUP_ROLE;

\connect REPLACE_WITH_DATABASE_NAME
REVOKE ALL ON SCHEMA public FROM REPLACE_WITH_BACKUP_ROLE;
GRANT USAGE ON SCHEMA public TO REPLACE_WITH_BACKUP_ROLE;
GRANT SELECT ON ALL TABLES IN SCHEMA public TO REPLACE_WITH_BACKUP_ROLE;
GRANT SELECT ON ALL SEQUENCES IN SCHEMA public TO REPLACE_WITH_BACKUP_ROLE;

ALTER DEFAULT PRIVILEGES FOR ROLE REPLACE_WITH_MIGRATION_ROLE IN SCHEMA public
    GRANT SELECT ON TABLES TO REPLACE_WITH_BACKUP_ROLE;
ALTER DEFAULT PRIVILEGES FOR ROLE REPLACE_WITH_MIGRATION_ROLE IN SCHEMA public
    GRANT SELECT ON SEQUENCES TO REPLACE_WITH_BACKUP_ROLE;

REVOKE CREATE ON SCHEMA public FROM REPLACE_WITH_BACKUP_ROLE;

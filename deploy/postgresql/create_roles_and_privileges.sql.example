\set ON_ERROR_STOP on

-- Run in psql as an existing PostgreSQL administrator only after replacing
-- every REPLACE_WITH_* identifier. Passwords are deliberately absent: set
-- them interactively afterwards with \password so they do not enter this file
-- or shell history.

CREATE ROLE REPLACE_WITH_MIGRATION_ROLE
    LOGIN
    NOSUPERUSER
    NOCREATEDB
    NOCREATEROLE
    NOINHERIT
    NOREPLICATION
    NOBYPASSRLS;

CREATE ROLE REPLACE_WITH_APP_ROLE
    LOGIN
    NOSUPERUSER
    NOCREATEDB
    NOCREATEROLE
    NOINHERIT
    NOREPLICATION
    NOBYPASSRLS;

REVOKE ALL ON DATABASE REPLACE_WITH_DATABASE_NAME FROM REPLACE_WITH_MIGRATION_ROLE;
REVOKE ALL ON DATABASE REPLACE_WITH_DATABASE_NAME FROM REPLACE_WITH_APP_ROLE;
GRANT CONNECT ON DATABASE REPLACE_WITH_DATABASE_NAME TO REPLACE_WITH_MIGRATION_ROLE;
GRANT CONNECT ON DATABASE REPLACE_WITH_DATABASE_NAME TO REPLACE_WITH_APP_ROLE;

-- Execute the remainder while connected to REPLACE_WITH_DATABASE_NAME.
\connect REPLACE_WITH_DATABASE_NAME
REVOKE CREATE ON SCHEMA public FROM PUBLIC;
REVOKE ALL ON SCHEMA public FROM REPLACE_WITH_APP_ROLE;
GRANT USAGE ON SCHEMA public TO REPLACE_WITH_APP_ROLE;
GRANT USAGE, CREATE ON SCHEMA public TO REPLACE_WITH_MIGRATION_ROLE;

-- Existing objects must first be inventoried and transferred to the migration
-- role with reviewed, object-specific ALTER ... OWNER statements. Do not use a
-- blind REASSIGN OWNED on a shared database. The grants below are safe after
-- ownership is correct.
GRANT SELECT, INSERT, UPDATE, DELETE ON ALL TABLES IN SCHEMA public
    TO REPLACE_WITH_APP_ROLE;
GRANT USAGE, SELECT ON ALL SEQUENCES IN SCHEMA public
    TO REPLACE_WITH_APP_ROLE;

ALTER DEFAULT PRIVILEGES FOR ROLE REPLACE_WITH_MIGRATION_ROLE IN SCHEMA public
    GRANT SELECT, INSERT, UPDATE, DELETE ON TABLES TO REPLACE_WITH_APP_ROLE;
ALTER DEFAULT PRIVILEGES FOR ROLE REPLACE_WITH_MIGRATION_ROLE IN SCHEMA public
    GRANT USAGE, SELECT ON SEQUENCES TO REPLACE_WITH_APP_ROLE;

-- Defensive revocations: the application role must not own objects and must
-- never receive schema DDL privileges.
REVOKE CREATE ON SCHEMA public FROM REPLACE_WITH_APP_ROLE;

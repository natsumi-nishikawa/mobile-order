VITE_COGNITO_DOMAIN=https://your-domain.auth.ap-northeast-1.amazoncognito.com
VITE_COGNITO_APP_CLIENT_ID=your-spa-app-client-id
VITE_COGNITO_REDIRECT_URI=http://localhost:5173
VITE_COGNITO_LOGOUT_URI=http://localhost:5173
# Leave empty for same-origin /api and /ws (recommended behind Nginx).
# Development uses the Vite proxy configured by VITE_DEV_BACKEND_URL.
VITE_API_BASE_URL=
VITE_WS_BASE_URL=
VITE_DEV_BACKEND_URL=http://localhost:8000
